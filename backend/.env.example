# Copy to .env. For Docker use root .env; for local run use backend/.env (or root).

# Google Drive OAuth (Connect button)
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/auth/callback
FRONTEND_URL=http://localhost:3000

# Gemini API
GEMINI_API_KEY=your_gemini_api_key

# App
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=http://localhost:3000

# Change values and redeploy / restart the API process to apply.
# RATE_LIMIT_CHAT_MESSAGE=20/minute
# RATE_LIMIT_CHAT_CREATE=40/minute
# RATE_LIMIT_DRIVE_SYNC=10/minute
# RATE_LIMIT_DRIVE_SORT=5/minute

# Optional: long random string. If set, you can clear in-memory rate limit counters without restart:
#   curl -X POST "http://localhost:8000/api/admin/reset-rate-limits?token=YOUR_SECRET"
#   or header X-Rate-Limit-Reset-Token: YOUR_SECRET
# Restarting the server also clears counters (Render: Manual Deploy > Restart or redeploy).
# RATE_LIMIT_RESET_SECRET=

# Set false on Render for demos to block automatic Drive file search in chat (saves Drive API).
# Explicit event-summary pills still load from Drive when connected.
# DRIVE_CONTEXT_SEARCH_ENABLED=false
